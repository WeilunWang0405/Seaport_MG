# Normalize text files to LF in repo; checkout as LF
* text=auto eol=lf

# Explicitly mark common text types
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf

# Binary files (do not touch line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary